<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        {% if project.subtitle %}
          <p class="card-text" style="margin-top: -0.5rem; margin-bottom: 0.5rem; opacity: 0.65; font-size: 0.8rem;">
            {{ project.subtitle }}
          </p>
        {% endif %}
        <p class="card-text">{{ project.description }}</p>
        {% if project.tags %}
          <div class="row ml-1 mr-1 p-0" style="gap: 0.35rem; margin-bottom: 0.5rem;">
            {% for tag in project.tags %}
              <span
                style="font-size: 0.7rem; padding: 0.2rem 0.5rem; border-radius: 3px; background: color-mix(in srgb, var(--global-theme-color) 13%, transparent); color: var(--global-theme-color);"
              >
                {{- tag -}}
              </span>
            {% endfor %}
          </div>
        {% endif %}
        <div class="row ml-1 mr-1 p-0">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </a>
</div>
